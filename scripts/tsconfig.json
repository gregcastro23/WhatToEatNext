{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    "isolatedModules": false,
    "noEmit": true,
    "incremental": false,
    "target": "ES2022",
    "esModuleInterop": true
  },
  "ts-node": {
    "transpileOnly": true,
    "files": true
  },
  "include": [
    "./**/*.ts",
    "../next-env.d.ts",
    "../src/types/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "../node_modules",
    "lib/__tests__/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/* 2.*",
    "**/* 3.*",
    "**/* 2/**",
    "**/* 3/**",
    "../.worktrees/**",
    ".worktrees/**",
    "../tests/**",
    "../__tests__/**",
    "../src/types/testing-library__jest-dom.d.ts",
    "../src/types/testing-library__jest-dom/**",
    "../src/types/jest-dom.d.ts",
    "../src/jest-dom.d.ts",
    "../src/types/utils.d.ts"
  ]
}
