{
  "id": "brown-rice",
  "name": "Brown rice",
  "aliases": [
    "brown rice",
    "long grain brown rice",
    "soaked brown rice",
    "whole grain brown rice"
  ],
  "catalogKeys": [
    "brown_rice"
  ],
  "safetyClass": "none",
  "summary": {
    "text": "Illinois Extension soaks brown rice in the refrigerator before cooking it on the stovetop or in an electric pressure cooker.",
    "sources": [
      "illinois-soaked-brown-rice"
    ]
  },
  "selection": [],
  "storage": [
    {
      "text": "Refrigerate leftover cooked brown rice covered for up to 4 days; freezing keeps it longer.",
      "sources": [
        "illinois-soaked-brown-rice"
      ]
    }
  ],
  "preparation": [
    {
      "text": "Rinse the dry rice two or three times, until the water runs clear.",
      "sources": [
        "illinois-soaked-brown-rice"
      ]
    },
    {
      "text": "Or rinse it in a mesh colander under running water for 1 minute.",
      "sources": [
        "illinois-soaked-brown-rice"
      ]
    },
    {
      "text": "Cover the rinsed rice with water by 1 inch.",
      "sources": [
        "illinois-soaked-brown-rice"
      ]
    },
    {
      "text": "Refrigerate the soaking rice for 6 to 8 hours or overnight.",
      "sources": [
        "illinois-soaked-brown-rice"
      ]
    },
    {
      "text": "Drain the soaked rice and cook it in fresh water.",
      "sources": [
        "illinois-soaked-brown-rice"
      ]
    }
  ],
  "substitutions": [],
  "safety": [
    {
      "text": "Rinsing before cooking has only a minimal effect on arsenic in the cooked grain, according to FDA.",
      "sources": [
        "fda-arsenic-rice"
      ]
    },
    {
      "text": "Cooking rice similar to how pasta is cooked, in extra water, can reduce inorganic arsenic by 40 to 60 percent, depending on the type of rice, per FDA.",
      "sources": [
        "fda-arsenic-rice"
      ]
    },
    {
      "text": "FDA describes that method as 6 to 10 parts water to 1 part rice, then draining the excess water.",
      "sources": [
        "fda-arsenic-rice"
      ]
    }
  ],
  "methods": [
    {
      "id": "pressure_cook",
      "label": "Pressure cook soaked rice",
      "best": true,
      "why": {
        "text": "Choose this when you want a quick cook: Illinois gives 14 minutes on high pressure, followed by a full natural release.",
        "sources": [
          "illinois-soaked-brown-rice"
        ]
      },
      "quantities": [
        {
          "kind": "size",
          "label": "dry brown rice in recipe batch",
          "min": 1,
