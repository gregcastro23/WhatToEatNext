          "unit": "cup",
          "sources": [
            "illinois-soaked-brown-rice"
          ]
        },
        {
          "kind": "ratio",
          "label": "water added to soaked rice for pressure cooker",
          "min": 1.25,
          "max": null,
          "unit": "cup",
          "sources": [
            "illinois-soaked-brown-rice"
          ]
        },
        {
          "kind": "time",
          "label": "high-pressure cook time",
          "min": 14,
          "max": null,
          "unit": "min",
          "sources": [
            "illinois-soaked-brown-rice"
          ]
        }
      ],
      "equipment": [
        "electric pressure cooker",
        "mesh colander"
      ],
      "steps": [
        {
          "text": "Add the soaked, drained rice and 1 1/4 cups water to an electric pressure cooker.",
          "sources": [
            "illinois-soaked-brown-rice"
          ]
        },
        {
          "text": "Set the lid to sealing and cook on high pressure for 14 minutes.",
          "sources": [
            "illinois-soaked-brown-rice"
          ]
        },
        {
          "text": "Let the pressure release naturally until it is fully released.",
          "sources": [
            "illinois-soaked-brown-rice"
          ]
        },
        {
          "text": "Turn the lid to open only after all pressure is released.",
          "sources": [
            "illinois-soaked-brown-rice"
          ]
        }
      ],
      "tips": [
        {
          "text": "Turn off the keep warm setting if the cooker defaults to it.",
          "sources": [
            "illinois-soaked-brown-rice"
          ]
        }
      ],
      "doneness": []
    },
    {
