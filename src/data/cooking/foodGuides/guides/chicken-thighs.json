          "unit": "°F",
          "sources": [
            "fn-thigh-bake"
          ]
        }
      ],
      "equipment": [
        "grill grates",
        "instant-read thermometer"
      ],
      "steps": [
        {
          "text": "Oil the grates to prevent sticking.",
          "sources": [
            "ncc-grill"
          ]
        },
        {
          "text": "Grill the thighs about 25 to 30 minutes.",
          "sources": [
            "ncc-grill"
          ]
        },
        {
          "text": "Check the thickest part; cook until it reads 165°F.",
          "sources": [
            "fn-thigh-bake"
          ]
        }
      ],
      "tips": [
        {
          "text": "Keep poultry chilled until it goes on the grill.",
          "sources": [
            "ncc-grill"
          ]
        }
      ],
      "doneness": [
        {
          "text": "Grill until the thickest part reads 165°F.",
