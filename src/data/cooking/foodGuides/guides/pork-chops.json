        {
          "text": "Broil on a broiler pan or sheet; a shallow baking dish or cookie sheet also works.",
          "sources": [
            "pork-broiling"
          ]
        },
        {
          "text": "Broil for roughly 3 to 18 minutes, depending on cut and broiler.",
          "sources": [
            "pork-broiling"
          ]
        },
        {
          "text": "Check for 145°F with a 3-minute rest.",
          "sources": [
