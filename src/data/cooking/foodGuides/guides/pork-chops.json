          "min": 10,
          "max": null,
          "unit": "min",
          "sources": [
            "pork-chops-pork-board"
          ]
        },
        {
          "kind": "time",
          "label": "Finish time after searing in a pan",
          "min": 6,
          "max": 8,
          "unit": "min",
          "sources": [
            "pork-chops-pork-board"
          ]
        },
        {
          "kind": "internal_temp",
          "label": "Internal temperature",
          "min": 145,
          "max": null,
          "unit": "°F",
          "sources": [
            "pork-chops-pork-board"
          ]
        },
        {
          "kind": "rest",
