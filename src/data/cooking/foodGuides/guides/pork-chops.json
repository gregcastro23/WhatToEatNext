          "min": 3,
          "max": null,
          "unit": "min",
          "sources": [
            "pork-chops-pork-board"
          ]
        }
      ],
      "equipment": [
        "baking sheet",
        "digital meat thermometer"
      ],
      "steps": [
        {
          "text": "Heat the oven to 425°F.",
          "sources": [
            "pork-chops-pork-board"
          ]
        },
        {
          "text": "Bake the chops for about 10 minutes.",
          "sources": [
            "pork-chops-pork-board"
          ]
        },
        {
          "text": "For a sear-first version, brown the chops in a pan, then move them to a baking sheet for 6 to 8 more minutes.",
          "sources": [
            "pork-chops-pork-board"
          ]
        },
        {
          "text": "Cook until the thickest part reads 145°F, then let the chops rest 3 minutes.",
          "sources": [
            "pork-chops-pork-board"
          ]
        }
      ],
      "tips": [
        {
          "text": "Cook by temperature with a digital meat thermometer rather than by time alone.",
          "sources": [
            "pork-chops-pork-board"
          ]
        }
      ],
      "doneness": [
        {
          "text": "Pull the chops when the internal temperature reaches 145°F, then rest 3 minutes.",
          "sources": [
            "pork-chops-pork-board"
          ]
        }
      ]
    },
