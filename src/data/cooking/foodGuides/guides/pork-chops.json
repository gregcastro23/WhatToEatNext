      ],
      "steps": [
        {
          "text": "Grill over direct, medium heat, turning once halfway through.",
          "sources": [
            "pork-grilling"
          ]
        },
        {
          "text": "Grill about 8 to 12 minutes for 3/4-inch chops, per Pork Board's grilling table.",
          "sources": [
            "pork-grilling"
          ]
        },
        {
          "text": "Take the chops off at 145°F and rest them 3 minutes.",
          "sources": [
            "pork-chops-pork-board"
          ]
        }
      ],
      "tips": [
        {
          "text": "Use spatulas or tongs rather than sharp utensils, so the juices stay in the meat.",
          "sources": [
            "pork-grilling"
          ]
        },
        {
          "text": "Sugar-based sauces burn if applied early; brush them on during the last few minutes.",
          "sources": [
            "pork-grilling"
          ]
        }
      ],
      "doneness": [
        {
          "text": "Cook to an internal temperature of 145°F, then rest 3 minutes.",
          "sources": [
            "pork-chops-pork-board"
          ]
        }
