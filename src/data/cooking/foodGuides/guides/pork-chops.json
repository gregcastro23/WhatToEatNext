{
  "id": "pork-chops",
  "name": "Pork chops",
  "aliases": [
    "bone-in pork chops",
    "boneless pork chops",
    "pork chops",
    "pork loin chops"
  ],
  "catalogKeys": [
    "pork"
  ],
  "safetyClass": "whole_meat",
  "summary": {
    "text": "Pork chops come from the loin and range from about ½ to 2 inches thick; cook them to 145°F with a 3-minute rest.",
    "sources": [
      "pork-chops-pork-board"
    ]
  },
  "selection": [
    {
      "text": "Bone-in chops often provide the most flavor because the fat and bone help keep the meat moist.",
      "sources": [
        "pork-chops-pork-board"
      ]
    }
  ],
  "storage": [
    {
      "text": "Refrigerated raw pork chops keep 2-4 days, according to Pork Board's table.",
      "sources": [
        "pork-buying-storing"
      ]
    },
    {
      "text": "Frozen pork chops keep 3-6 months, according to the same table.",
      "sources": [
        "pork-buying-storing"
      ]
    },
    {
      "text": "Wrapped pork for the freezer should be held at 0°F or lower.",
      "sources": [
        "pork-buying-storing"
      ]
    }
  ],
  "preparation": [
    {
      "text": "Thaw pork in the refrigerator, still in its wrapping.",
      "sources": [
        "pork-buying-storing"
      ]
    },
    {
      "text": "A one-inch thick chop needs about 12-14 hours to thaw in the refrigerator.",
      "sources": [
        "pork-buying-storing"
      ]
    }
  ],
  "substitutions": [],
  "safety": [
    {
      "text": "Cook chops to at least 145°F, then rest them 3 minutes before eating.",
      "sources": [
        "pork-safety-tips"
      ]
    },
    {
      "text": "Check the internal temperature in the thickest part of the chop.",
      "sources": [
        "pork-safety-tips"
      ]
    },
    {
      "text": "Never thaw pork at room temperature.",
      "sources": [
        "pork-safety-tips"
      ]
    },
    {
      "text": "Do not leave raw pork at room temperature for more than two hours before refrigerating or freezing it.",
      "sources": [
        "pork-safety-tips"
      ]
    }
  ],
  "methods": [
    {
      "id": "oven_bake",
      "label": "Oven bake at 425°F",
      "best": true,
      "why": {
        "text": "Pork Board calls oven baking about as easy as a dinner can get, which suits a weeknight meal.",
        "sources": [
          "pork-chops-pork-board"
        ]
      },
      "quantities": [
        {
          "kind": "oven_temp",
          "label": "Oven temperature",
