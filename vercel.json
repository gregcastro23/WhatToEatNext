{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "ignoreCommand": "node scripts/vercel-ignore-build-step.cjs",
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "bunVersion": "1.3",
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/synthetic-onboarding",
      "schedule": "2,17,32,47 * * * *"
    },
    {
      "path": "/api/cron/synthetic-cosmic-recipe",
      "schedule": "25 * * * *"
    },
    {
      "path": "/api/cron/synthetic-recommendations",
      "schedule": "4,19,34,49 * * * *"
    },
    {
      "path": "/api/cron/synthetic-stripe-webhook",
      "schedule": "6,21,36,51 * * * *"
    },
    {
      "path": "/api/cron/synthetic-auth-handshake",
      "schedule": "8,23,38,53 * * * *"
    },
    {
      "path": "/api/cron/synthetic-auth-signin",
      "schedule": "11,26,41,56 * * * *"
    },
    {
      "path": "/api/cron/synthetic-mcp",
      "schedule": "13,43 * * * *"
    },
    {
      "path": "/api/cron/system-health-snapshot",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/observability-prune",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/cache-ephemeris",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/cron/prewarm-agent-recipes",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/esms-reconciliation",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/agents-daily-yield",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/chain-reconcile",
      "schedule": "45 * * * *"
    },
    {
      "path": "/api/cron/environmental-ingest",
      "schedule": "10 * * * *"
    }
  ],
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1",
    "NODE_OPTIONS": "--max-old-space-size=4096"
  }
}